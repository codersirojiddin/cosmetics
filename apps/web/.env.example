# Public API base URL (the Go backend). Inlined at build time: set it BEFORE `pnpm build`.
NEXT_PUBLIC_API_URL=http://localhost:8080
# Same API, used by server-side rendering (can be an internal URL). Defaults to NEXT_PUBLIC_API_URL.
API_URL=
# Shown in the header, footer and page titles
NEXT_PUBLIC_SHOP_NAME=Cosmetics
