# Copy to .env for local development. Never commit .env.
APP_ENV=development
PORT=8080

# Postgres. Local example below; for Neon use the *pooled* URL for DATABASE_URL and the
# direct (non-pooler) URL for DIRECT_URL (used for migrations). Keep ?sslmode=require for Neon.
DATABASE_URL=postgres://cosmetics:cosmetics@127.0.0.1:5432/cosmetics_dev?sslmode=disable
DIRECT_URL=
AUTO_MIGRATE=false

# at least 32 characters: openssl rand -hex 32
JWT_SECRET=

# Telegram bot (create with @BotFather). BOT_MODE: polling (dev) | webhook (prod) | off
TELEGRAM_BOT_TOKEN=
BOT_MODE=off
BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Telegram user ids that become owners at login. Message the bot /id to learn yours.
OWNER_TELEGRAM_IDS=

# Public URLs
PUBLIC_API_URL=
WEB_URL=
CORS_ORIGINS=http://localhost:3000

# Files: local (dev) or s3 (Cloudflare R2 etc.; needs two buckets: one public, one private)
STORAGE_DRIVER=local
UPLOADS_DIR=./uploads
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_PUBLIC=
S3_BUCKET_PRIVATE=
S3_PUBLIC_BASE_URL=
